msgctxt "hotkey metadata"
msgid "In-game"
msgstr "Durante o jogo"

msgctxt "hotkey metadata"
msgid "In-game hotkeys."
msgstr "Atalhos de teclado durante o jogo."

msgctxt "hotkey metadata"
msgid "Focus Civic Center"
msgstr "Focar Centro Cívico"

msgctxt "hotkey metadata"
msgid "Cycle through the local player's completed Civic Center buildings, oldest to newest."
msgstr "Alterna entre os Centros Cívicos completos do jogador local, do mais antigo ao mais novo."

